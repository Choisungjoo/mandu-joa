# Files that must never be committed

# --- Build output (regenerated by the build) ---
target/
frontend/node_modules/
frontend/dist/

# --- Secrets (tokens, keys, passwords) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
credentials.json
client_secret*.json
service-account*.json
src/main/resources/application-local.properties

# --- Logs ---
*.log
logs/

# --- IDE / tool settings ---
.idea/
*.iml
.vscode/
.claude/settings.local.json

# --- AI assistant instructions (personal) ---
CLAUDE.md
CLAUDE.local.md

# --- OS-generated files ---
.DS_Store
Thumbs.db
desktop.ini
